+) * len(PARENT_BACK_GUARD_STUB):
+    raise EntropyRuntimeError("parent Back guard stub no longer owns NOP space")
+_SCANNER_BLOCK = (
+    _SCANNER_BLOCK[:_parent_back_guard_stub_offset]
